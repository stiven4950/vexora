rules_version = '2';
// Solo el servidor (cuenta de servicio, que no pasa por estas reglas) lee y escribe Firestore.
// La web nunca accede directo: todo va por la API (docs/despliegue_cloud_run.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
