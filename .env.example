# Copia este archivo como .env y pon tu clave. .env no se sube a git.
OPENAI_API_KEY=
# Análisis profundo (opcional, de pago): Gemini ve el video completo. docs/analisis_profundo.md
GEMINI_API_KEY=

# ----- Almacén y cola (docs/despliegue_cloud_run.md). Sin estas variables: JSON y archivos en
# api_data/ y un trabajador en un hilo de la API, como siempre.
# VEXORA_STORE=json            # json | firestore
# VEXORA_BLOBS=local           # local | gcs
# VEXORA_BUCKET=               # con gcs: p. ej. vexora-dev.firebasestorage.app
# VEXORA_FIREBASE_PROJECT=     # proyecto de Firebase / Google Cloud (también para la autenticación)
# GOOGLE_APPLICATION_CREDENTIALS=  # ruta a la llave de la cuenta de servicio (solo en local)
# VEXORA_FIRESTORE_PREFIX=     # prefijo de colecciones (p. ej. staging_)
# VEXORA_INPROCESS_WORKERS=1   # trabajadores en hilos de la API; 0 = la API solo encola y sirve
# VEXORA_WORKERS=1             # trabajadores por proceso de vexora-worker
# VEXORA_LEASE_S=60            # duración del turno de un trabajo (se renueva cada tercio)
# VEXORA_QUEUE_POLL_S=         # espera entre búsquedas de trabajo (1 s en local, 5 s en Firestore)
