# =================================================================================================
# Variables de la API y de los trabajadores de Vexora (Python).
#
# Copia este archivo como `.env` en la raíz del repositorio y llena lo que necesites. `.env` NO se
# sube a git (está en .gitignore). En producción (Cloud Run) las variables se ponen en el servicio y
# los secretos van en Secret Manager (docs/despliegue_cloud_run.md), nunca dentro de la imagen.
#
# Las líneas comentadas (#) muestran el valor por defecto: si no la defines, se usa ese.
# [SECRETO] = no la compartas, no la pegues en chats ni la subas a ningún repositorio.
# Las variables de la web van aparte, en web/.env.example.
# =================================================================================================


# ----- Inteligencia artificial (todas opcionales) --------------------------------------------------

# [SECRETO] Clave de OpenAI. La usan el lector de escena (mira unos fotogramas para entender el
# video), la detección de accesorios (gafas, gorra) y el director con LLM. Sin ella, esas partes se
# apagan y el resto funciona igual.
OPENAI_API_KEY=

# [SECRETO] Clave de Google Gemini para el "análisis profundo" (opcional y de pago: ve el video
# completo y escribe la coreografía). Sin ella, el análisis profundo no está disponible.
# docs/analisis_profundo.md
GEMINI_API_KEY=

# Archivo con los precios por modelo para estimar el costo de cada llamada a IA en la telemetría.
# VEXORA_LLM_PRICES=configs/llm_prices.yaml


# ----- Cuentas y seguridad ------------------------------------------------------------------------

# on: cada petición necesita la sesión de Firebase. off: sin login (SOLO desarrollo local; el
# servidor se niega a escuchar fuera de 127.0.0.1 con off).
# VEXORA_AUTH=on

# Proyecto de Firebase / Google Cloud (p. ej. vexora-dev). Con él se verifican las sesiones de
# Firebase y, en la nube, se conectan Firestore y Storage.
VEXORA_FIREBASE_PROJECT=

# [SECRETO] Clave para firmar las URLs de los videos (?k=). Sin ella se inventa una al arrancar y
# los enlaces dejan de valer al reiniciar. En producción: fija, larga (p. ej. `openssl rand -hex 32`)
# e IGUAL en todas las instancias de la API.
VEXORA_SECRET=

# Correo (verificado) de la cuenta que adopta los trabajos hechos antes de que existieran las
# cuentas. Déjalo vacío si no tienes trabajos viejos.
VEXORA_LEGACY_OWNER=

# Orígenes de la web que pueden llamar a la API (separados por comas). En producción: el dominio de
# Vercel, p. ej. https://vexora.vercel.app. Nunca "*".
# VEXORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cuántos proxies de confianza hay delante de la API, para saber la IP real de quien pide (límites
# de los enlaces públicos). 0 en local; 1 en Cloud Run; 2 con un balanceador de carga delante.
# VEXORA_PROXY_HOPS=0


# ----- Planes ---------------------------------------------------------------------------------------

# Mientras no hay pagos: asigna un plan a cuentas concretas (uid de Firebase:plan, separadas por
# comas). Sirve para probar Pro/Ultra (guardar en la nube, compartir). Solo se lee en el servidor.
# Los planes, precios y lo que permite cada uno están en configs/plans.yaml.
# VEXORA_PLAN_GRANTS=uidDeFirebase1:pro,uidDeFirebase2:ultra


# ----- Límites de uso por persona (protegen el costo y la cola) ------------------------------------

# Duración máxima del video subido, en segundos.
# VEXORA_MAX_VIDEO_SECONDS=180
# Lado más largo máximo del video, en píxeles (2160 = 4K).
# VEXORA_MAX_VIDEO_SIDE=2160
# Videos procesándose o en cola a la vez por persona.
# VEXORA_MAX_ACTIVE_JOBS=2
# Videos que una persona puede crear por día.
# VEXORA_DAILY_JOBS=20
# Vistas previas por día por persona (editor y Estudio juntas; las que salen de caché no cuentan).
# VEXORA_DAILY_PREVIEWS=60
# Análisis profundos (de pago) por día por persona, y en total para toda la app.
# VEXORA_DAILY_DEEP=2
# VEXORA_DAILY_DEEP_GLOBAL=20
# Correos (separados por comas) que pueden usar el análisis profundo. Vacío = nadie.
VEXORA_DEEP_ALLOW=


# ----- Almacén de datos y archivos (docs/despliegue_cloud_run.md) ----------------------------------
# Sin estas variables: datos en api_data/*.json, archivos en api_data/ y un trabajador dentro de la
# API. Es lo normal en local.

# Dónde viven los datos (trabajos, subidas, perfiles, avisos, enlaces): json (local) | firestore.
# VEXORA_STORE=json
# Dónde viven los archivos (videos, resultados, capas): local | gcs (Firebase Storage).
# VEXORA_BLOBS=local
# Con gcs: el bucket de Firebase Storage, sin gs:// (p. ej. vexora-dev.firebasestorage.app).
VEXORA_BUCKET=
# [SECRETO: es una ruta a una llave] Solo en local, para hablar con Firestore/Storage reales: ruta
# al JSON de la cuenta de servicio, guardado FUERA del repositorio. En Cloud Run no se usa: el
# servicio ya tiene su cuenta.
GOOGLE_APPLICATION_CREDENTIALS=
# Prefijo de las colecciones de Firestore (p. ej. staging_) para separar entornos en un proyecto.
# VEXORA_FIRESTORE_PREFIX=


# ----- Cola y trabajadores --------------------------------------------------------------------------

# Trabajadores (hilos) dentro de la API que procesan videos. 0 = la API solo encola y sirve; los
# videos los procesa `vexora-worker` (así se usa en Cloud Run).
# VEXORA_INPROCESS_WORKERS=1
# Trabajadores por cada proceso de `vexora-worker`.
# VEXORA_WORKERS=1
# Segundos que dura el "turno" de un trabajador sobre un video; se renueva cada tercio. Si el
# trabajador muere, el video vuelve a la cola al vencer (hasta 3 intentos).
# VEXORA_LEASE_S=60
# Segundos entre búsquedas de trabajo cuando la cola está vacía (por defecto 1 en local, 5 con Firestore).
# VEXORA_QUEUE_POLL_S=


# ----- Servidor y registros ---------------------------------------------------------------------------

# dev | prod. En prod se ocultan /docs y /openapi.json; también etiqueta los eventos de telemetría.
# VEXORA_ENV=dev
# Dirección y puerto de `vfxglow-api`. En Cloud Run: VFXGLOW_HOST=0.0.0.0 y el puerto de $PORT.
# VFXGLOW_HOST=127.0.0.1
# VFXGLOW_PORT=8000
# Carpeta raíz de la app (configs/, api_data/). Por defecto, la carpeta desde donde se arranca.
# VFXGLOW_ROOT=
# Formato del registro en consola: json (una línea JSON por evento, para Grafana/Datadog) | text.
# VEXORA_LOG_FORMAT=json
# Carpeta del registro en disco (logs/events.jsonl, con rotación).
# VEXORA_LOG_DIR=logs
