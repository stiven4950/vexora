# =================================================================================================
# Variables de la web de Vexora (React + Vite).
#
# Copia este archivo como `web/.env.local` y llénalo. `.env.local` NO se sube a git.
# En Vercel: Project Settings → Environment Variables (las mismas, una por una).
#
# OJO: todo lo que empieza por VITE_ termina DENTRO del JavaScript que descarga el navegador, así
# que cualquiera puede verlo. Aquí NUNCA va un secreto (claves de OpenAI, Gemini, VEXORA_SECRET,
# la cuenta de servicio...): esos van solo en el `.env` de la API.
# Las variables de la API van aparte, en el .env.example de la raíz.
# =================================================================================================


# ----- Firebase Authentication (inicio de sesión) --------------------------------------------------
# Consola de Firebase → Configuración del proyecto → Tus apps → la app web. Son públicas por diseño
# (identifican el proyecto; la seguridad la dan las reglas y la verificación del token en la API).
#
# Sin VITE_FIREBASE_API_KEY la web NO pide sesión: solo para desarrollo, con la API en VEXORA_AUTH=off.

# Clave pública de la app web de Firebase.
VITE_FIREBASE_API_KEY=
# Dominio de inicio de sesión (p. ej. vexora-dev.firebaseapp.com).
VITE_FIREBASE_AUTH_DOMAIN=
# Id del proyecto (p. ej. vexora-dev). Debe ser el mismo que VEXORA_FIREBASE_PROJECT de la API.
VITE_FIREBASE_PROJECT_ID=
# Bucket de Storage del proyecto (p. ej. vexora-dev.firebasestorage.app).
VITE_FIREBASE_STORAGE_BUCKET=
# Identificador del remitente de mensajes de Firebase.
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Id de la app web en Firebase.
VITE_FIREBASE_APP_ID=


# ----- Contenido pendiente --------------------------------------------------------------------------

# 1 = muestra los datos de ejemplo marcados PENDIENTE en web/src/mocks/pendientes.ts (saldo de
# créditos, uso, historial, testimonios). En desarrollo (npm run dev) se ven siempre; en el build
# de producción quedan ocultos salvo con 1. No lo actives en producción: son cifras inventadas.
# VITE_SHOW_PENDING=


# ----- Solo para desarrollo local (no es VITE_: no llega al navegador) -----------------------------

# A dónde manda Vite las peticiones /api durante `npm run dev`. Por defecto, la API local.
# Se define en la terminal, no aquí: VEXORA_API=http://127.0.0.1:8011 npm run dev
# VEXORA_API=http://127.0.0.1:8000
